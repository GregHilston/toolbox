.claude/handoffs/

.vscode/

*.log

venv/

.idea/

*.*~

dots/

*.pyc

# The recursive glob in .zshrc puts every subdirectory of bin/ on $PATH, so a
# stray __pycache__ becomes a PATH entry. Keep it out of the repo entirely.
__pycache__/

backup

.bashrc
.tmux*

.vagrant

*.sw[po]
.*.sw[po]

.DS_Store
iterm2-colors

dot/env/dyn.env

# Karabiner-Elements writes into the stowed dir: rolling config backups, and
# complex-modification rules imported through its UI
dot/karabiner/.config/karabiner/automatic_backups/
dot/karabiner/.config/karabiner/assets/

private/

# nix build output
result

# omlx runtime state
dot/omlx/.omlx/stats.json

# omlx secrets (generated from settings.json.tpl via `just secrets`)
dot/omlx/.omlx/settings.json

# pi runtime state (sessions, auth tokens, generated files)
dot/pi/.pi/agent/sessions/
dot/pi/.pi/agent/auth.json
dot/pi/.pi/agent/models-store.json

# extracted release archives (e.g. pi binary dropped here accidentally)
/pi/

# oMLX runtime directory symlink (stow creates ~/.omlx -> dot/omlx/.omlx)
/.omlx

# direnv secrets (use .envrc.example for structure)
nixos/.envrc

# generated secrets (use secrets/.env.tpl as template, run `just secrets`)
nixos/secrets/.env

# Written by the git-hooks flake module whenever a nix command evaluates the flake.
# It is a symlink into /nix/store, so committing it pins a path that exists on exactly
# one machine — and a `git add -A` sweeps it up silently.
.pre-commit-config.yaml
