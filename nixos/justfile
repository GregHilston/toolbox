set shell := ["zsh", "-cu"]
flake_path := "~/Git/toolbox/nixos"

# List available hosts
list-hosts:
  @find hosts -mindepth 2 -maxdepth 2 -type d -exec basename {} \;

# List past NixOS generations
list-generations:
  sudo nix-env --list-generations --profile /nix/var/nix/profiles/system

# Delete specific generations
delete-specific-generations generations:
  nix-collect-garbage --delete-generations {{generations}}

# Delete all old generations. Can remove sudo to remove not remove system packages
delete-all-old-generations:
  sudo nix-collect-garbage --delete-old

up:
  nix flake update

# Update specific input
# usage: just upp home-manager
upp input:
  nix flake update {{input}}

# Rebuild
# The host argument is required.
# The flake_path defaults to the `~/Git/toolbox`
# Usage: Override the path with `just fr <hostname> flake_path=.` or `just fr <hostname> flake_path=~/toolbox/nixos`
# Usage: `just fr <hostname>`
fr host flake_path=flake_path: # Default to current directory
  nh os switch --hostname {{host}} {{flake_path}}

# Test rebuild
# The host argument is required.
# The flake_path defaults to `~/Git/toolbox`
# Usage: `just ft <hostname>`
ft host flake_path=flake_path: # Default to current directory
  nh os test --hostname {{host}} {{flake_path}}

# Update and Rebuild Flake
# Usage: `just fu <hostname>` flake_path defaults to the cwd
fu host flake_path=flake_path:
    nh os switch --hostname {{host}} --update {{flake_path}}

history:
  sudo nix profile history --profile /nix/var/nix/profiles/system

repl:
  nix repl -f flake:nixpkgs

clean:
  # remove all generations older than 7 days
  sudo nix profile wipe-history --profile /nix/var/nix/profiles/system  --older-than 7d

gc:
  # garbage collect all unused nix store entries
  sudo nix-collect-garbage --delete-old

# Darwin rebuild (macOS)
# Usage: `just dr <hostname>`
dr host flake_path=flake_path:
  ~/Git/toolbox/bin/aerospace-save-state.sh
  sudo darwin-rebuild switch --flake {{flake_path}}#{{host}}
  ~/Git/toolbox/bin/aerospace-restore-state.sh
  @echo ""
  @echo "Tip: Run 'just checklist' for post-deploy setup tasks"

# Darwin test (macOS)
# Usage: `just dt <hostname>`
dt host flake_path=flake_path:
  sudo darwin-rebuild check --flake {{flake_path}}#{{host}}

# Validate all configurations (run in devcontainer or any Nix environment)
# Host lists are derived from the flake, so new hosts are covered automatically.
#
# Evaluates each host's toplevel .drvPath rather than `nix build --dry-run`,
# because instantiating a derivation needs no builder for its platform — so
# this validates the aarch64-darwin hosts from the x86_64-linux devcontainer
# too. Evaluation is what we are actually checking either way.
validate:
  #!/usr/bin/env bash
  set -euo pipefail

  nix flake check

  # NixOS and Darwin differ only in where the toplevel derivation hangs, so
  # flatten both into one list of installables and walk it once.
  #
  # One assignment each, deliberately. A command substitution takes the status of
  # its LAST command, so collecting both `nix eval`s inside a single `$( ... )`
  # would let a failure in the first one be masked by success in the second —
  # `set -e` never sees it, jq emits nothing, and the loop below silently skips a
  # whole platform while still exiting 0.
  nixos_targets=$(nix eval .#nixosConfigurations --apply builtins.attrNames --json \
    | jq -r '.[] | ".#nixosConfigurations.\(.).config.system.build.toplevel"')
  darwin_targets=$(nix eval .#darwinConfigurations --apply builtins.attrNames --json \
    | jq -r '.[] | ".#darwinConfigurations.\(.).system"')
  targets="$nixos_targets
  $darwin_targets"

  # Each side separately, not `-z "$nixos_targets$darwin_targets"`: the failure
  # worth catching is one platform vanishing, and a combined test only fires when
  # BOTH are empty. `nix eval` on an empty attrset succeeds and yields `[]`, so a
  # Darwin list that quietly became empty would sail past a combined guard on the
  # strength of the NixOS hosts — on CI's Linux runner, where evaluating the Macs
  # is the one thing `nix flake check` does not already cover.
  if [ -z "$nixos_targets" ]; then
    echo "no NixOS configurations found — refusing to report success" >&2
    exit 1
  fi
  if [ -z "$darwin_targets" ]; then
    echo "no Darwin configurations found — refusing to report success" >&2
    exit 1
  fi

  for target in $targets; do
    echo "==> $target"
    nix eval --raw "$target.drvPath" >/dev/null
  done

  echo "All configurations valid!"

# Generate secret files from 1Password templates.
# Run this once after cloning, or after updating secrets in 1Password.
#
# Authentication, in order of preference:
#
#   1. A service account token, from $OP_SERVICE_ACCOUNT_TOKEN or the file
#      ~/.config/op/service-account-token. This authenticates with no GUI at
#      all, which is the only way `op inject` can work on a headless host.
#
#   2. The 1Password desktop app's CLI integration (Settings → Developer →
#      Integrate with 1Password CLI). This is GUI-gated: on a headless machine
#      it fails with "error initializing client: authorization timeout", so
#      dungeon needs either a token (preferred) or a VNC session first.
secrets:
  #!/usr/bin/env bash
  set -euo pipefail

  TOKEN_FILE="$HOME/.config/op/service-account-token"
  if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -r "$TOKEN_FILE" ]; then
    OP_SERVICE_ACCOUNT_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
    export OP_SERVICE_ACCOUNT_TOKEN
  fi

  if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    echo "==> op: using service account token (headless-capable)"
  else
    echo "==> op: no service account token found; falling back to the desktop app"
    echo "    integration, which requires a GUI session on this host."
  fi

  op inject -f -i ../dot/omlx/.omlx/settings.json.tpl -o ../dot/omlx/.omlx/settings.json
  op inject -f -i ../dot/pi/.pi/agent/models.json.tpl -o ../dot/pi/.pi/agent/models.json
  op inject -f -i secrets/.env.tpl -o secrets/.env
  echo "Secrets generated. Run 'just dr <host>' to deploy."

# Install and start PI WEB on this host (one time, moria only)
#
# Not an activation script on purpose. This needs the network and a real user
# login session for `launchctl bootstrap`, neither of which activation has — and
# `pi-web install` writes and validates its own launchd plists, so nix declaring
# them would break `pi-web doctor`/`status`/`restart`. See
# modules/darwin/pi-web.nix.
#
# Re-running is safe: pi-web replaces its existing services rather than
# duplicating them, so this doubles as the upgrade path.
# Usage: `just pi-web-setup`
pi-web-setup:
  #!/usr/bin/env bash
  set -euo pipefail
  # npm 11 does NOT run install scripts by default (dangerously-allow-all-scripts
  # is false), and node-pty needs one to build its native module. --allow-scripts
  # permits that single package without opening the gate for the whole tree, so
  # the flag is load-bearing — do not drop it. It is rejected for project-scoped
  # installs and accepted for -g, which is what this is.
  npm install -g @jmfederico/pi-web --allow-scripts=node-pty

  # node-pty ships its macOS spawn-helper without the executable bit, so PI WEB
  # installs fine, serves fine, and then every terminal fails to open. `pi-web
  # doctor` catches it and exits non-zero. npm recreates the file on each
  # upgrade, so this has to run here rather than be a one-time manual chmod.
  #   https://github.com/microsoft/node-pty/issues/850
  #   https://github.com/jmfederico/pi-web/issues/4
  # Guarded on darwin: the bug and the prebuilds path are macOS-only.
  if [ "$(uname -s)" = "Darwin" ]; then
    for helper in "$(npm root -g)"/@jmfederico/pi-web/node_modules/node-pty/prebuilds/darwin-*/spawn-helper; do
      if [ -f "$helper" ] && [ ! -x "$helper" ]; then
        chmod +x "$helper"
        echo "✓ chmod +x $helper"
      fi
    done
  fi

  pi-web install
  pi-web doctor
  pi-web status

# Show post-deploy checklist for Darwin/macOS setup
# Usage: `just checklist`
checklist:
  @cat docs/darwin-post-deploy.md
