{
  "schemaVersion": "0.1.0",
  "name": "hn",
  "behavior": "create",
  "noteNameFormat": "{{title|lower|replace:\"/[^a-z0-9]+/g\":\" \"|trim|split:\" \"|slice:0,12|join:\"-\"}}",
  "path": "clippings",
  "noteContentFormat": "\n\n## Content\n\n{{content}}\n",
  "properties": [
    {
      "name": "type",
      "value": "hn",
      "type": "text"
    },
    {
      "name": "source",
      "value": "{{url}}",
      "type": "text"
    },
    {
      "name": "author",
      "value": "{{author}}",
      "type": "text"
    },
    {
      "name": "published",
      "value": "{{published}}",
      "type": "date"
    },
    {
      "name": "clipped",
      "value": "{{date}}",
      "type": "date"
    },
    {
      "name": "topics",
      "value": "",
      "type": "multitext"
    },
    {
      "name": "status",
      "value": "unread",
      "type": "text"
    }
  ],
  "triggers": [
    "https://news.ycombinator.com/item"
  ]
}
