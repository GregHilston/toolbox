{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_FORCE_SESSION_PERSISTENCE": "1",
    "DRADIS_URL": "https://dungeon.tail1b9d9.ts.net:10000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(searxngr:*)",
      "WebFetch(domain:staq-studios.sentry.io)",
      "Skill(searxngr-search)",
      "Bash(bash */marimo-pair/scripts/discover-servers.sh *)",
      "Bash(bash */marimo-pair/scripts/execute-code.sh *)",
      "Bash(nix build *)",
      "Bash(nix eval *)",
      "Bash(nix fmt)",
      "Bash(nix fmt *)",
      "Bash(docker compose logs *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose config *)",
      "Bash(npm view *)",
      "Bash(npm root *)",
      "Bash(npm run build)",
      "Bash(npm run type-check *)",
      "Bash(npm run test:unit *)",
      "Bash(npm run test:integration *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)"
    ]
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-env.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh SessionStart",
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-delete.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-build-on-dungeon.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-ai-attribution.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/no-piped-gate.py"
          },
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pushover-quota-stall.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh Notification",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-subagent.sh start",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh SubagentStart",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-subagent.sh stop",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh SubagentStop",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/herdr-subagent.sh end"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh SessionEnd",
            "timeout": 2
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/log-order.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh UserPromptSubmit",
            "timeout": 2,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/Git/toolbox/bin/worktree-done-hook post-push",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/Git/toolbox/bin/worktree-done-hook stop",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/shift-drain.py"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh Stop",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh wake",
            "timeout": 86400,
            "asyncRewake": true
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/dradis-hook.sh PostToolBatch",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.npm-global/bin/ccstatusline",
    "padding": 0,
    "refreshInterval": 10
  },
  "extraKnownMarketplaces": {
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit"
      }
    }
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "crit@crit": true
  },
  "effortLevel": "high",
  "autoCompactWindow": 1000000,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoCompactEnabled": false,
  "idleCompaction": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754006348784
  }
}
