// Remote Control servers for the Claude app, started by `rc` in .zshrc.
// Each pane restarts its server: it exits after ~10 minutes offline.
layout {
    pane split_direction="vertical" {
        pane split_direction="horizontal" {
            pane name="toolbox" command="bash" {
                args "-c" "while :; do $HOME/Git/toolbox/bin/claude-rc.sh toolbox; sleep 10; done"
            }
            pane name="home-lab" command="bash" {
                args "-c" "while :; do $HOME/Git/toolbox/bin/claude-rc.sh home-lab; sleep 10; done"
            }
        }
        pane split_direction="horizontal" {
            pane name="ccs" command="bash" {
                args "-c" "while :; do $HOME/Git/toolbox/bin/claude-rc.sh ccs; sleep 10; done"
            }
            pane name="notes" command="bash" {
                args "-c" "while :; do $HOME/Git/toolbox/bin/claude-rc.sh notes; sleep 10; done"
            }
        }
    }
}
