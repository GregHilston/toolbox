# Generated from models.json.tpl via `just secrets` (contains API key)
.pi/agent/models.json
# Managed by home-manager (pi.nix)
.pi/agent/settings.json
.pi/agent/reddit-research.json
.pi/agent/searxng.json
# Installed by `pi install` at runtime — reinstalled by nix activation.
# These only land inside the repo at all because ~/.pi is a folded stow
# symlink into it; see the CAVEAT in dot/justfile.
.pi/agent/git/
.pi/agent/npm/
# Runtime session data
.pi/agent/sessions/
# Model catalogues moonpi refetches and rewrites on a timer — regenerable, and
# host-specific. It writes synthetic-models-cache.json and
# wafer-models-cache.json, so the class is ignored rather than each name.
.pi/agent/*-cache.json
# pi-fff's frecency database — binary runtime state, rewritten constantly
.pi/agent/fff/
# Backup files from home-manager
*.backup
