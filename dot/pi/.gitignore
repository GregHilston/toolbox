# Generated from models.json.tpl via `just secrets` (contains API key)
.pi/agent/models.json
# Managed by home-manager (pi.nix)
.pi/agent/settings.json
.pi/agent/reddit-research.json
.pi/agent/searxng.json
# Installed by `pi install` at runtime — reinstalled by nix activation.
# These only land inside the repo at all because ~/.pi is a folded stow
# symlink into it; see the CAVEAT in dot/justfile.
.pi/agent/git/
.pi/agent/npm/
# Runtime session data
.pi/agent/sessions/
# pi-permission-system's decision log — runtime state, appended on every
# permission check. Only lands in the repo because ~/.pi is a folded stow
# symlink into it; the extension's config.json beside it IS committed.
.pi/agent/extensions/pi-permission-system/logs/
# pi-fff's frecency database — binary runtime state, rewritten constantly
.pi/agent/fff/
# pi-powerline-footer's runtime state. Same folded-symlink reason as above, and
# worse than most: stash-history.json and inbox.jsonl hold prompt text and
# bash-history holds shell commands, so a `git add -A dot` would commit them.
# Its theme.json override lives at .pi/agent/extensions/powerline-footer/ and
# IS meant to be committed — same split as pi-permission-system above.
.pi/agent/powerline-footer/
.pi/agent/vibes/
# Backup files from home-manager
*.backup
