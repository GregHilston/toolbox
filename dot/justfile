set shell := ["zsh", "-cu"]

# The target directory for stow (home directory)
target := env("HOME")

# Packages the *-all recipes operate on.
#
# This is an explicit allowlist, NOT a `*/` glob — a glob silently deploys any
# stale package nobody remembered to delete. Adding a new package? Add it here.
#
# Two packages in dot/ are deliberately excluded and must never be stowed:
#
#   claude/  deployed by direct symlink instead — see the link_repo helper in
#            the root justfile and modules/programs/tui/claude.nix.
#   omlx/    deployed by direct `ln` in modules/darwin/omlx.nix, which explains
#            why: "a bare `stow` from dot/ targets the parent (the repo), not
#            $HOME". Stowing it creates toolbox/.omlx inside the working tree —
#            the accident the `/.omlx` entry in the root .gitignore documents.
#
# CAVEAT, not yet fixed: `pi` has the same directory-folding hazard. If ~/.pi
# does not already exist, stow folds it to a single symlink into this repo and
# pi then writes runtime state inside the working tree — which is why
# .gitignore carries dot/pi/.pi/agent/{sessions,auth.json,models-store.json}.
# It stays on the list because it has always been stowed and removing it would
# be a behavior change, but prefer `stow --no-folding pi` on a fresh host.
# `ser2net` is the same story: dungeon stows it with --no-folding explicitly
# (hosts/macs/dungeon/default.nix), while these recipes fold.
packages := "aerospace karabiner pi searxngr-config ser2net tmux zsh"

# Stow a single package
# Usage: just stow aerospace
stow package:
    stow -v -t {{target}} {{package}}

# Unstow a single package
# Usage: just unstow aerospace
unstow package:
    stow -v -D -t {{target}} {{package}}

# Restow (unstow then stow) a single package — useful after reorganizing
# Usage: just restow aerospace
restow package:
    stow -v -R -t {{target}} {{package}}

# Stow every package in the allowlist
stow-all:
    #!/usr/bin/env zsh
    set -eu
    for pkg in {{packages}}; do
        echo "Stowing $pkg..."
        stow -v -t {{target}} "$pkg"
    done

# Unstow every package in the allowlist
unstow-all:
    #!/usr/bin/env zsh
    set -eu
    for pkg in {{packages}}; do
        echo "Unstowing $pkg..."
        stow -v -D -t {{target}} "$pkg"
    done

# Restow every package in the allowlist
restow-all:
    #!/usr/bin/env zsh
    set -eu
    for pkg in {{packages}}; do
        echo "Restowing $pkg..."
        stow -v -R -t {{target}} "$pkg"
    done

# List the packages the *-all recipes manage
list:
    @for pkg in {{packages}}; do echo "$pkg"; done

# List every directory in dot/, flagging any that the *-all recipes skip
list-all:
    #!/usr/bin/env zsh
    set -eu
    for pkg in */; do
        pkg="${pkg%/}"
        if [[ " {{packages}} " == *" $pkg "* ]]; then
            echo "$pkg"
        else
            echo "$pkg  (not stowed — deployed by symlink; see the packages list in this justfile)"
        fi
    done

# Dry-run stow for a package (shows what would happen)
# Usage: just dry-run aerospace
dry-run package:
    stow -v -n -t {{target}} {{package}}

# Dry-run every package in the allowlist (shows what stow-all would do)
dry-run-all:
    #!/usr/bin/env zsh
    # Deliberately no `set -e`: stow exits non-zero on a conflict, and the whole
    # point of a dry run is to see EVERY conflict in one pass rather than
    # fix-and-rerun once per package.
    set -u
    rc=0
    for pkg in {{packages}}; do
        echo "--- $pkg"
        stow -v -n -t {{target}} "$pkg" || rc=1
    done
    exit $rc
