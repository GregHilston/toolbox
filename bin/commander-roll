#!/usr/bin/env python3
"""Roll a commander: check its run log, push the log, then run orchestrator-roll.

What a commander's drain text tells it to run (docs/commander.md). The log's
`## Current` block must differ from the last roll's, so a fresh session never
restarts from stale orders. The hash is stored as roll_hash and becomes
log_hash only when the worker lands the roll, so a failed roll can retry.
Exit codes are orchestrator-roll's; 1 also means the log check refused.
"""

from __future__ import annotations

import hashlib
import os
import re
import subprocess
import sys
from pathlib import Path

import claude_shift


def refuse(message: str) -> int:
    print(f"commander-roll: {message}", file=sys.stderr)
    return 1


HOOK_HEADING = re.compile(r"^### (\d{4}-\d\d-\d\d \d\d:\d\d) (Greg|XO|restart|notice)$")


def unanswered(text: str) -> str | None:
    """The time of Greg's last message when no commander entry follows it."""
    greg = None
    for line in text.splitlines():
        if not line.startswith("### "):
            continue
        m = HOOK_HEADING.match(line)
        if not m:
            greg = None
        elif m.group(2) == "Greg":
            greg = m.group(1)
    return greg


def main() -> int:
    pane = claude_shift.pane()
    if not pane:
        return refuse("HERDR_PANE_ID and HC_TERMINAL_ID are unset.")
    with claude_shift.locked(pane):
        try:
            state = claude_shift.load(pane)
        except claude_shift.Invalid as e:
            return refuse(f"this pane's state file is corrupt ({e}).")
        if not state:
            return refuse("this pane is not armed; run `shift-arm` first.")
        log = state.get("log")
        if not log:
            return refuse("this pane was armed without --log; re-arm it with `shift-arm --log PATH`.")
        try:
            text = Path(log).read_text()
        except OSError as e:
            return refuse(f"cannot read the run log: {e}")
        section = re.search(r"^## Current[ \t]*\n(.*?)(?=^## |\Z)", text, re.S | re.M)
        if not section:
            return refuse(f"{log} has no `## Current` section.")
        waiting = unanswered(text)
        if waiting:
            return refuse(f"Greg's message of {waiting} has no journal entry after it; answer it there first.")
        digest = hashlib.sha256(section.group(1).strip().encode()).hexdigest()
        if digest == state.get("log_hash"):
            return refuse("the log's `## Current` section is unchanged since the last roll; rewrite it first.")
        state["roll_hash"] = digest
        claude_shift.save(pane, state)
    git = ["git", "-C", state["repo"]]
    subprocess.run([*git, "add", "--", log], capture_output=True)
    subprocess.run([*git, "commit", "-q", "-m", "run log: shift roll", "--", log], capture_output=True)
    push = subprocess.run([*git, "push", "-q"], capture_output=True, text=True)
    if push.returncode:
        print(f"commander-roll: push failed, rolling anyway: {push.stderr.strip()}", file=sys.stderr)
    roll = os.environ.get("ORCHESTRATOR_ROLL") or str(Path(__file__).resolve().parent / "orchestrator-roll")
    return subprocess.run([roll]).returncode


if __name__ == "__main__":
    sys.exit(main())
