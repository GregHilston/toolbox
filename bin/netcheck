#!/usr/bin/env python3
"""Walk the network ladder from moria and name the first failing layer.

Built for a fallback agent triaging an outage, so it is stdlib-only (no uv, which
needs the network) and read-only. Every probe runs at once; the ladder is then
walked in order, so one slow timeout cannot stack and "what still works" is
known even when a low layer fails. macOS only.
"""
import argparse
import json
import re
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

GATEWAY = "192.168.1.1"
DUNGEON = "192.168.1.238"
LOCAL_NAME = "llm.grehg2.xyz"
RUNBOOK = "~/Git/home-lab/docs/runbooks/network-outage.md"
SERVICES = {
    "gateway": "https://llm.grehg2.xyz/v1/models",
    "omlx": "http://localhost:8000/v1/models",
    "searxng": "http://100.103.22.125:8214",
}

# verdict -> (message, next step)
VERDICTS = {
    "NO_LINK": ("no IP on the active interface", f"{RUNBOOK} NO_LINK"),
    "DHCP_FAIL": ("interface has a 169.254 address; DHCP failed", f"{RUNBOOK} DHCP_FAIL"),
    "GATEWAY_DOWN": ("router 192.168.1.1 does not answer", f"{RUNBOOK} GATEWAY_DOWN"),
    "DUNGEON_DOWN": ("router is up but dungeon does not answer", f"{RUNBOOK} DUNGEON_DOWN"),
    "WAN_DOWN": ("LAN is fine but no internet by IP", f"{RUNBOOK} WAN_DOWN"),
    "ROUTER_DNS_DOWN": ("router DNS fails; 1.1.1.1 works", f"{RUNBOOK} ROUTER_DNS_DOWN"),
    "UPSTREAM_DNS_DOWN": ("no public DNS from router or 1.1.1.1", f"{RUNBOOK} UPSTREAM_DNS_DOWN"),
    "DNSMASQ_DOWN": ("dnsmasq on dungeon does not resolve local names", f"{RUNBOOK} DNSMASQ_DOWN"),
    "LOCAL_DNS_RULE": ("dnsmasq works but the router does not forward to it", f"{RUNBOOK} LOCAL_DNS_RULE"),
    "TAILSCALE_DOWN": ("Tailscale is not running", f"{RUNBOOK} TAILSCALE_DOWN"),
    "SERVICE_DOWN": ("a key service does not answer", f"{RUNBOOK} SERVICE_DOWN"),
    "OK": ("every layer passes", "nothing"),
}


def run(cmd, timeout=5):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout.strip()
    except (subprocess.TimeoutExpired, FileNotFoundError):
        return 1, ""


def probe_link():
    _, out = run(["route", "-n", "get", "default"])
    m = re.search(r"interface:\s*(\S+)", out)
    if not m:
        return False, "no default route"
    _, ip = run(["ipconfig", "getifaddr", m.group(1)])
    return bool(ip), f"{m.group(1)} {ip or 'no IP'}"


def ping(host):
    rc, _ = run(["ping", "-c", "2", "-W", "1000", host], timeout=5)
    return rc == 0, host


def dig(name, server):
    _, out = run(["dig", "+short", "+time=2", "+tries=1", name, f"@{server}"], timeout=5)
    ips = [l for l in out.splitlines() if re.fullmatch(r"[\d.]+", l)]
    return bool(ips), ips[0] if ips else "no answer"


def http(url):
    _, out = run(["curl", "-s", "-o", "/dev/null", "-m", "4", "-w", "%{http_code}", url], timeout=6)
    code = out or "000"
    return code != "000" and not code.startswith("5"), code


def probe_tailscale():
    _, out = run(["tailscale", "status", "--json"])
    try:
        state = json.loads(out)["BackendState"]
    except (ValueError, KeyError):
        return False, "unknown"
    return state == "Running", state


def probe_wan():
    ok = [ping(h) for h in ("1.1.1.1", "8.8.8.8")]
    return any(o for o, _ in ok), " ".join(f"{h}={'up' if o else 'down'}" for (o, h) in ok)


def collect():
    jobs = {
        "link": probe_link,
        "gateway": lambda: ping(GATEWAY),
        "dungeon": lambda: ping(DUNGEON),
        "wan": probe_wan,
        "dns_router": lambda: dig("example.com", GATEWAY),
        "dns_direct": lambda: dig("example.com", "1.1.1.1"),
        "local_router": lambda: dig(LOCAL_NAME, GATEWAY),
        "local_dnsmasq": lambda: dig(LOCAL_NAME, DUNGEON),
        "tailscale": probe_tailscale,
        **{f"svc_{k}": (lambda u=u: http(u)) for k, u in SERVICES.items()},
    }
    with ThreadPoolExecutor(len(jobs)) as pool:
        futures = {k: pool.submit(f) for k, f in jobs.items()}
        return {k: f.result() for k, f in futures.items()}


def diagnose(r):
    """First failing layer of results {probe: (ok, detail)} -> verdict key."""
    if not r["link"][0]:
        return "NO_LINK"
    if r["link"][1].split()[-1].startswith("169.254"):
        return "DHCP_FAIL"
    if not r["gateway"][0]:
        return "GATEWAY_DOWN"
    if not r["dungeon"][0]:
        return "DUNGEON_DOWN"
    if not r["wan"][0]:
        return "WAN_DOWN"
    if not r["dns_router"][0]:
        return "ROUTER_DNS_DOWN" if r["dns_direct"][0] else "UPSTREAM_DNS_DOWN"
    if not r["local_dnsmasq"][0]:
        return "DNSMASQ_DOWN"
    if not (r["local_router"][0] and r["local_router"][1] == DUNGEON):
        return "LOCAL_DNS_RULE"
    if not r["tailscale"][0]:
        return "TAILSCALE_DOWN"
    if any(not r[f"svc_{k}"][0] for k in SERVICES):
        return "SERVICE_DOWN"
    return "OK"


def works(r):
    omlx = r["svc_omlx"][0]
    cloud = r["svc_gateway"][0] and r["wan"][0]
    return (
        f"local model: omlx on localhost:8000 {'OK' if omlx else 'DOWN'}; "
        f"cloud models: {'available' if cloud else 'unavailable'}; "
        f"LAN: {'up' if r['gateway'][0] else 'down'}; "
        f"internet: {'up' if r['wan'][0] else 'down'}"
    )


def service_detail(r):
    return ", ".join(f"{k}={r[f'svc_{k}'][1]}" for k in SERVICES)


def main(argv=None):
    ap = argparse.ArgumentParser(description="Triage a network outage, lowest layer first.")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    args = ap.parse_args(argv)
    r = collect()
    key = diagnose(r)
    message, nxt = VERDICTS[key]
    if key == "SERVICE_DOWN":
        message += f" ({service_detail(r)})"
    if args.json:
        print(json.dumps({
            "verdict": key, "message": message, "next": nxt, "works": works(r),
            "probes": {k: {"ok": ok, "detail": d} for k, (ok, d) in r.items()},
        }, indent=2))
    else:
        for k, (ok, d) in r.items():
            print(f"{'ok  ' if ok else 'FAIL'} {k:14} {d}")
        print(f"VERDICT: {key}: {message}")
        print(f"next: {nxt}")
        print(f"works: {works(r)}")
    return 0 if key == "OK" else 1


if __name__ == "__main__":
    sys.exit(main())
