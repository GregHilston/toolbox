#!/usr/bin/env python3
"""Roll this armed Claude Code session over to a fresh context: /clear, then the restart prompt.

Run by the session itself, from its Bash tool, after shift-drain.py told it to
drain. It starts a detached worker, which must outlive this Bash call and the
turn: /clear can only go in once the session has stopped with no background
task or cron left, as the Stop hook records. A stale count can't refuse here,
or a drain that waited on subagents would idle silently; the worker waits
for a stop after this call instead. The roll counts only once the restart
prompt is in. On failure the worker sends a Pushover, leaves the session as
it is and re-opens the drain. `shift-arm --off` cancels a queued roll.
Logs to ~/.cache/claude-shift/<hash>.log.

While it waits on live background tasks it also reaps orphaned godot gate
processes (bin/roll_reap.py), only the rolling repo's; `--reap [--dry-run] [--repo]` runs just that.

Exit codes: 0 roll queued, 1 refused (the message says why), 2 bad arguments.
"""

from __future__ import annotations

import argparse
import io
import json
import os
import subprocess
import sys
import time
import uuid
from pathlib import Path

import claude_shift
import roll_reap
from claude_shift import log, notify, short

HERDR = os.environ.get("HERDR_BIN_PATH") or "herdr"
HC = os.environ.get("HC_BIN_PATH") or "hc"
IDLE = ("idle", "done")
DRAIN_TIMEOUT = 20 * 60
CLEAR_TIMEOUT = 120
NUDGE = (
    "Shift roll waited {minutes} min: {busy} background task(s) still live. A wait on a detached job "
    "is not live work: it survives /clear. TaskStop every background shell, subagent and Monitor "
    "(note any pid on its ticket), then run orchestrator-roll and end your turn."
)
POLL = 2
NUDGE_AFTER = 120
SETTLE = 3  # idle must hold this long
REAP_EVERY = 60


class Failed(Exception):
    pass


class Cancelled(Exception):
    pass


def herdr(*args: str, timeout: float = 60) -> dict:
    """Run herdr and return its JSON; an error body fails even on exit 0."""
    out = subprocess.run([HERDR, *args], capture_output=True, text=True, timeout=timeout)
    text = (out.stdout or out.stderr).strip()
    try:
        body = json.loads(text.splitlines()[-1]) if text else {}
    except ValueError:
        body = {}
    if out.returncode or "error" in body:
        error = body.get("error") or {}
        raise Failed(error.get("code") or short(text), short(f"herdr {' '.join(args[:2])}: {error.get('message') or text}"))
    return body


def hc(*args: str, timeout: float = 120) -> dict:
    """Run hc (the Herdr desktop app's CLI) and return its JSON."""
    out = subprocess.run([HC, *args, "--json"], capture_output=True, text=True, timeout=timeout)
    text = (out.stdout or out.stderr).strip()
    if out.returncode:
        raise Failed("hc", short(f"hc {' '.join(args[:2])}: {text}"))
    try:
        return json.loads(text) if text else {}
    except ValueError:
        return {}


def status(pane: str) -> str:
    if pane.startswith("hc:"):
        return (hc("get", pane[3:]).get("status") or {}).get("state", "")
    return herdr("agent", "get", pane)["result"]["agent"]["agent_status"]


def prompt(pane: str, text: str, wait: bool = False) -> None:
    if pane.startswith("hc:"):
        hc("send", pane[3:], text)
    elif wait:
        herdr("agent", "prompt", pane, text, "--wait", "--until", "working", "--timeout", "30000", timeout=60)
    else:
        herdr("agent", "prompt", pane, text)


def current(pane: str, token: str) -> dict:
    """This roll's state, or Cancelled if --off or a newer roll replaced it."""
    try:
        state = claude_shift.load(pane)
    except claude_shift.Invalid as e:
        raise Failed("state", f"state file corrupt: {e}") from None
    if not state or state["roll_id"] != token:
        raise Cancelled
    return state


def reap_orphans(pane: str, repo: str) -> None:
    """Kill gate processes a finished agent left behind; they hold `busy` above 0."""
    out = io.StringIO()
    try:
        roll_reap.reap(repo, out=out)
    except Exception as e:  # a reaper bug must not stall the roll
        out.write(f"reaper failed: {short(e)}\n")
    for line in out.getvalue().splitlines():
        if not line.startswith("live:"):
            log(pane, f"reap: {line}")


def wait_stopped(pane: str, token: str, since: int) -> None:
    """Until a stop after `since` left nothing live and the agent has stayed idle."""
    start = time.monotonic()
    deadline = start + DRAIN_TIMEOUT
    seen = None
    next_reap = 0.0
    nudged = False
    while time.monotonic() < deadline:
        with claude_shift.locked(pane):
            state = current(pane, token)
        # hc says working while a shell lives
        if not nudged and state["busy"] and state["stops"] > since and time.monotonic() - start >= NUDGE_AFTER:
            prompt(pane, NUDGE.format(minutes=NUDGE_AFTER // 60, busy=state["busy"]))
            nudged = True
        if state["busy"] and time.monotonic() >= next_reap:
            next_reap = time.monotonic() + REAP_EVERY
            reap_orphans(pane, state["repo"])
        if state["stops"] > since and state["busy"] == 0 and status(pane) in IDLE:
            if seen == state["stops"]:
                return
            seen = state["stops"]
            time.sleep(SETTLE)
            continue
        seen = None
        time.sleep(POLL)
    if not nudged and state["busy"] and status(pane) in IDLE:
        prompt(pane, NUDGE.format(minutes=DRAIN_TIMEOUT // 60, busy=state["busy"]))
    raise Failed("drain", f"no idle stop with nothing live within {DRAIN_TIMEOUT // 60} min "
                 f"(busy {state['busy']}, status {status(pane)})")  # fmt: skip


def wait_idle(pane: str, timeout: float) -> None:
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if status(pane) in IDLE:
            time.sleep(SETTLE)
            if status(pane) in IDLE:
                return
        time.sleep(POLL)
    raise Failed("idle", f"agent not idle {int(timeout)}s after /clear")


def worker(pane: str, token: str) -> None:
    step = "loading state"
    label = f"shift roll on {pane}"
    try:
        with claude_shift.locked(pane):
            state = current(pane, token)
        label = f"shift roll {state['rolls'] + 1}/{state['max_rolls']} on {pane}"
        step = "waiting for the drained turn to end with nothing live"
        log(pane, f"{label}: {step}")
        wait_stopped(pane, token, state["roll_stops"])
        step = "sending /clear"
        with claude_shift.locked(pane):
            current(pane, token)  # --off may have cancelled
            log(pane, step)
            prompt(pane, "/clear")
            state = current(pane, token)
            drained = f"{state['tokens'] // 1000}k tokens" if state["tokens"] else "unknown tokens"
            state.update(announced=None, tokens=None, busy=0)
            claude_shift.save(pane, state)
        time.sleep(SETTLE)
        wait_idle(pane, CLEAR_TIMEOUT)
        step = "sending the restart prompt"
        log(pane, step)
        try:
            prompt(pane, state["prompt"], wait=True)
        except Failed as e:
            if e.args[0] not in ("timeout", "agent_prompt_stalled"):
                raise
            log(pane, f"warning: prompt sent but no working state seen ({e.args[0]})")
        with claude_shift.locked(pane):
            state = current(pane, token)
            state.update(rolls=state["rolls"] + 1, roll_id=None, worker_pid=None)
            if "roll_hash" in state:
                state["log_hash"] = state.pop("roll_hash")
            claude_shift.save(pane, state)
        log(pane, f"{label}: done")
        notify(pane, f"Claude rolled shift {state['rolls']}/{state['max_rolls']} at {drained} "
                     f"({Path(state['repo']).name}, {pane})")  # fmt: skip
    except Cancelled:
        log(pane, f"{label}: cancelled before {step}")
    except Exception as e:
        detail = e.args[-1] if isinstance(e, Failed) else repr(e)
        log(pane, f"FAILED {step}: {short(detail)}")
        try:
            with claude_shift.locked(pane):
                state = claude_shift.load(pane)
                if state and state["roll_id"] == token:
                    state.update(roll_id=None, worker_pid=None, announced=None)
                    claude_shift.save(pane, state)
        except Exception as e2:
            log(pane, f"could not reset state: {short(e2)}")
        notify(pane, f"Claude {label} failed while {step}: {short(detail)}. Session left as it is; next stop re-drains.")


def alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def refuse(message: str) -> int:
    print(f"orchestrator-roll: {message}", file=sys.stderr)
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--reap", action="store_true", help="list and kill orphaned gate processes, then exit")
    parser.add_argument("--dry-run", action="store_true", help="with --reap: only say what would be killed")
    parser.add_argument("--repo", help="with --reap: the repo whose gates to reap (default: this checkout)")
    parser.add_argument("--worker", nargs=2, metavar=("PANE", "TOKEN"), help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.worker:
        worker(*args.worker)
        return 0
    if args.reap:
        git = roll_reap.common_dir(".")
        repo = args.repo or (git and os.path.dirname(git))
        if not repo:
            parser.error("--reap needs --repo outside a git checkout")
        roll_reap.reap(repo, dry_run=args.dry_run)
        return 0
    if args.dry_run or args.repo:
        parser.error("--dry-run and --repo need --reap")

    pane = claude_shift.pane()
    if not pane:
        return refuse("HERDR_PANE_ID and HC_TERMINAL_ID are unset; run this inside the armed Herdr pane or hc terminal.")
    token = uuid.uuid4().hex
    with claude_shift.locked(pane):
        try:
            state = claude_shift.load(pane)
        except claude_shift.Invalid as e:
            return refuse(f"this pane's state file is corrupt ({e}); tell Greg, then `shift-arm --off` and re-arm.")
        if not state:
            return refuse("this pane is not armed; run `shift-arm` first.")
        if state["rolls"] >= state["max_rolls"]:
            return refuse(f"{state['rolls']}/{state['max_rolls']} rolls used. Send Greg one Pushover "
                          "saying the shift limit is reached, and stop.")  # fmt: skip
        if state["stops"] == 0:
            return refuse("the Stop hook has never run on this pane (no Stop counted). Check "
                          "~/.claude/hooks/shift-drain.py exists and is listed under hooks.Stop in "
                          "~/.claude/settings.json, and tell Greg.")  # fmt: skip
        if state["roll_id"] and alive(state["worker_pid"]):
            return refuse("a roll is already queued; end your turn and it will go ahead.")
        try:
            status(pane)
        except (Failed, OSError, subprocess.TimeoutExpired) as e:
            return refuse(f"Herdr can't see this pane's agent: {e.args[-1]}")
        state.update(roll_id=token, roll_stops=state["stops"], worker_pid=None)
        claude_shift.save(pane, state)
        try:
            with open(claude_shift.log_path(pane), "a") as out:
                proc = subprocess.Popen(
                    [sys.executable, __file__, "--worker", pane, token],
                    stdin=subprocess.DEVNULL, stdout=out, stderr=out,
                    start_new_session=True, close_fds=True,
                )  # fmt: skip
            time.sleep(0.3)
            if proc.poll() is not None:
                raise OSError(f"worker exited at once with {proc.returncode}")
        except OSError as e:
            state.update(roll_id=None)
            claude_shift.save(pane, state)
            notify(pane, f"Claude shift roll on {pane} could not start its worker: {short(e)}")
            return refuse(f"could not start the roll worker: {e}. Greg has been told.")
        state.update(worker_pid=proc.pid)
        claude_shift.save(pane, state)
    live = f" {state['busy']} background task(s) or cron(s) were live at the last stop; it waits for them." if state["busy"] else ""
    print(f"Roll {state['rolls'] + 1}/{state['max_rolls']} queued. End your turn now; once this session "
          f"stops with nothing live, it gets /clear and then the restart prompt.{live}")  # fmt: skip
    return 0


if __name__ == "__main__":
    sys.exit(main())
